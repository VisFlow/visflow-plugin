{
  "name": "visflow",
  "displayName": "VisFlow",
  "description": "A living, annotated architecture map for AI-built projects.",
  "version": "0.9.1",
  "author": { "name": "Ben Xu & Alex Xu" },
  "homepage": "https://github.com/visflow/visflow-plugin",
  "keywords": ["architecture", "diagram", "map", "visualization"],
  "mcpServers": {
    "visflow-record-decision": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/mcp/record-decision-server.js"],
      "env": {
        "VISFLOW_REPO_ROOT": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
